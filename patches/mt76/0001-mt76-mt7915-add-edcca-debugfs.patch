 		debugfs_create_u32("dfs_hw_pattern", 0400, dir,
diff --git a/mt7915/mcu.c b/mt7915/mcu.c
index 6625f90..79bf8c3 100644
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -4231,3 +4231,49 @@ int mt7915_mcu_rf_regval(struct mt7915_dev *dev, u32 regidx, u32 *val, bool set)
 
 	return 0;
 }
+
+/* EDCCA (energy detect CCA) control, using the vendor MCU command 0xba.
+ *
+ * mode:
+ *   MT7915_EDCCA_CTRL_SET_EN    -> enable: EDCCA_MODE_FORCE_DISABLE(0) turns the
+ *                                  energy detect off, EDCCA_MODE_AUTO(1) hands
+ *                                  control back to the firmware
+ *   MT7915_EDCCA_CTRL_SET_THERS -> pri20/sec40/sec80 thresholds (firmware units)
+ *
+ * The command is not guaranteed to be implemented by the firmware (unknown for
+ * the MT7981 WM firmware); if it is not, the MCU call times out. It is only
+ * issued from the debugfs file, i.e. when the user asks for it explicitly.
+ */
+int mt7915_mcu_set_edcca(struct mt7915_phy *phy, u8 mode, u8 enable,
+			 u8 pri20, u8 sec40, u8 sec80)
+{
+	struct mt7915_dev *dev = phy->dev;
+	struct {
+		u8 band_idx;
+		u8 cmd_idx;
+		u8 setting[3];
+		bool record_in_fw;
+		u8 region;
+		s8 thres_compensation;
+	} __packed req = {
+		.band_idx = phy->mt76->band_idx,
+		.cmd_idx = mode,
+		.record_in_fw = false,
+	};
+
+	switch (mode) {
+	case MT7915_EDCCA_CTRL_SET_EN:
+		req.setting[0] = enable;
+		break;
+	case MT7915_EDCCA_CTRL_SET_THERS:
+		req.setting[0] = pri20;
+		req.setting[1] = sec40;
+		req.setting[2] = sec80;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(EDCCA),
+				 &req, sizeof(req), true);
+}
