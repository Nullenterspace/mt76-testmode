diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index e80d154..5ff5fcb 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1289,6 +1289,60 @@ mt7915_rf_regval_set(void *data, u64 val)
 DEFINE_DEBUGFS_ATTRIBUTE(fops_rf_regval, mt7915_rf_regval_get,
 			 mt7915_rf_regval_set, "0x%08llx\n");
 
+/* EDCCA control (raise/disable the energy-detect CCA threshold).
+ *
+ * Usage:
+ *   echo off              > /sys/kernel/debug/ieee80211/phy0/mt76/edcca
+ *   echo auto             > /sys/kernel/debug/ieee80211/phy0/mt76/edcca
+ *   echo "thresh 90 90 90" > /sys/kernel/debug/ieee80211/phy0/mt76/edcca
+ *
+ * With EDCCA disabled the radio no longer defers because of energy heard on
+ * the channel, so the own tx airtime goes up (at the cost of being less
+ * friendly to neighbours). The MCU command may be unsupported by the
+ * firmware; that only fails this one call, it is never issued implicitly.
+ */
+static ssize_t
+mt7915_edcca_write(struct file *file, const char __user *user_buf,
+		   size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	char buf[64];
+	unsigned int v1, v2, v3;
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+	if (count && buf[count - 1] == '\n')
+		buf[count - 1] = '\0';
+
+	if (!strcmp(buf, "off"))
+		ret = mt7915_mcu_set_edcca(phy, MT7915_EDCCA_CTRL_SET_EN,
+					   MT7915_EDCCA_MODE_FORCE_DISABLE,
+					   0, 0, 0);
+	else if (!strcmp(buf, "auto"))
+		ret = mt7915_mcu_set_edcca(phy, MT7915_EDCCA_CTRL_SET_EN,
+					   MT7915_EDCCA_MODE_AUTO, 0, 0, 0);
+	else if (sscanf(buf, "thresh %u %u %u", &v1, &v2, &v3) == 3)
+		ret = mt7915_mcu_set_edcca(phy, MT7915_EDCCA_CTRL_SET_THERS, 0,
+					   min_t(unsigned int, v1, 255),
+					   min_t(unsigned int, v2, 255),
+					   min_t(unsigned int, v3, 255));
+	else
+		return -EINVAL;
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations fops_edcca = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = mt7915_edcca_write,
+	.llseek = default_llseek,
+};
+
 int mt7915_init_debugfs(struct mt7915_phy *phy)
 {
 	struct mt7915_dev *dev = phy->dev;
@@ -1324,6 +1378,7 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
